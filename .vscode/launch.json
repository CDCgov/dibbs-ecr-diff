  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pytest Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
